# Copy this file to .env.local and fill in real values from Dragon Admin Center
# and your Microsoft Entra app registration. Never commit .env.local.

# --- Dragon Admin Center ---
VITE_DRAGON_PARTNER_GUID=
VITE_DRAGON_MEDICAL_SERVER_URL=
VITE_DRAGON_MEDICAL_SERVER_SCOPE=
VITE_DRAGON_ENVIRONMENT_ID=

# --- Microsoft Entra ID app registration (used by MSAL) ---
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=

# --- App identity as registered with Dragon Copilot ---
VITE_APPLICATION_NAME=Doctor Robbie
