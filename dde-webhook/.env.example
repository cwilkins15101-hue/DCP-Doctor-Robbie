# Copy to .env and fill in before running: npm run provision-webhook

ENTRA_TENANT_ID=50b0f407-cfdb-4951-8ec8-ab8f9d4217ea
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

DRAGON_API_SCOPE=105be974-d66d-43c9-b813-57a967bbfd21/.default
# Confirmed reachable — the "non-production" URL given in the partner
# portal (partnerapi-qa.ppe.copilot.dragon.com) does not actually resolve;
# this US production endpoint does and is what's confirmed working.
DRAGON_API_BASE_URL=https://partnerapi.copilot.us.dragon.com

DRAGON_PARTNER_GUID=a57b649c-4bbf-403e-9d4f-94bb41360ccf
DRAGON_ENVIRONMENT_ID=5dd85466-db44-41d2-8c0a-ef9448eaefeb
DRAGON_PRODUCT_ID=4f939ade-287a-416d-8484-1e64013039dd

# --- Token Launch (opens Dragon Copilot's own web UI in a new browser ---
# --- tab, seeded with this encounter's patient/correlation context)   ---
# No access-token setting here — Token Launch requires a delegated token
# for an actual signed-in physician (confirmed via a live 401 rejecting an
# app-only token), which the Doctor Robbie APP obtains directly via its own
# Microsoft sign-in (see the app's own .env.example, EXPO_PUBLIC_MSFT_*,
# and msftAuth.js) — this server only ever hands back plain identifiers
# below, never a credential.
DRAGON_EHR_BASE_URL=https://dragon-ehr.copilot.us.dragon.com
# Defaults to "doctor-robbie" — this account's Clinical app connector name
# (Dragon Admin Center > Clinical app connector > Overview), which matches
# the Token Launch docs' description of this field ("the name of the EHR
# system making the call"). If Token Launch calls fail (e.g. error 26,
# EhrIdMissing), try the connector's "App ID" GUID instead (also on that
# Overview tab) by setting it here.
DRAGON_EHR_ID=doctor-robbie
DRAGON_CLIENT_NAME=Doctor Robbie

# The public URL of your deployed Azure Function. IMPORTANT: Flex
# Consumption Function Apps get a randomized hostname suffix — check the
# "Default domain" field on the Function App's Overview page in the Azure
# Portal rather than assuming it's just <app-name>.azurewebsites.net.
# e.g. https://dr-robbie-gwctbmh0cwc2bzbz.westus3-01.azurewebsites.net/api/dde-webhook
WEBHOOK_URL=

# Must match the WEBHOOK_SHARED_SECRET app setting on the Function itself.
WEBHOOK_SHARED_SECRET=
