# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Doctor Robbie's own login — Microsoft sign-in (msftAuth.js) ---
# Required before anything else in the app is reachable. Same Entra tenant/
# app registration dde-webhook already uses server-to-server elsewhere, but
# this is an interactive, delegated sign-in (a real physician authenticates
# directly) — needed because Dragon Copilot's Token Launch API ("Launch
# Dragon Copilot" button) rejects an app-only, server-minted token outright.
# Defaults match this account's confirmed-working values, so these can be
# left blank unless Microsoft gives you different ones.
EXPO_PUBLIC_MSFT_TENANT_ID=50b0f407-cfdb-4951-8ec8-ab8f9d4217ea
EXPO_PUBLIC_MSFT_CLIENT_ID=b1fc69fc-9d91-4b8d-9151-3a1892ae17fd
# IMPORTANT: whatever redirect URI this triggers (logged to the Debug Log
# the first time you sign in from a new platform/URL) must be registered on
# that Entra app registration's "Single-page application" platform
# specifically — registering it under "Web" instead breaks the token
# exchange with a CORS error, since it's called directly from browser JS
# with no client secret.

# --- Dragon Copilot recording submission — no separate sign-in needed, ---
# --- this is a plain server upload (separate from the login above)    ---
# The deployed Azure Function's real URL (check the Portal's "Default
# domain" field — Flex Consumption apps get a randomized hostname suffix).
# e.g. https://dr-robbie-gwctbmh0cwc2bzbz.westus3-01.azurewebsites.net
EXPO_PUBLIC_DDE_SERVER_URL=
# Must match APP_SHARED_SECRET in the Function App's settings.
EXPO_PUBLIC_DDE_APP_SECRET=
# Required — identifies which physician this is to Dragon Copilot. Must
# exactly match an "App user ID" registered on the Clinical app connector in
# the Dragon Admin Center (admin.healthplatform.microsoft.com) — an
# unregistered value is rejected with "Forbidden". Defaults to
# "doctor-robbie-physician" if unset, which is NOT a registered ID; set this
# to your real registered App user ID (e.g. "craigwilkins").
EXPO_PUBLIC_DRAGON_EXTERNAL_USER_ID=

# --- Dragon Copilot SDK for JavaScript (dragonCopilotSdk.js) — web-only ---
# --- ambient recording, added 2026-09-24 as an alternative to the raw   ---
# --- AAS WebSocket, per Microsoft's own recommendation                  ---
# Same values dde-webhook's own settings already use server-side
# (DRAGON_PARTNER_GUID/DRAGON_ENVIRONMENT_ID) — duplicated here with the
# EXPO_PUBLIC_ prefix since the app needs them client-side for this SDK,
# unlike the REST/WebSocket paths where only the server ever sees them.
EXPO_PUBLIC_DRAGON_PARTNER_GUID=
EXPO_PUBLIC_DRAGON_ENVIRONMENT_ID=
# Optional — defaults to en-US.
EXPO_PUBLIC_DRAGON_SPEECH_LANGUAGE=

# --- Epic on FHIR sandbox (patient lookup, plus "Epic Chart Summary" — ---
# --- Conditions, International Patient Summary, and Clinical Notes) ---
# Register a free "Non-Production" app at https://fhir.epic.com/Developer
# to get a Client ID — sandbox client IDs work immediately, no approval
# needed. Public client (SMART standalone launch, PKCE) — no client secret.
# On the app's Incoming APIs list, add (all R4 — watch for other-version
# entries with the same name, e.g. STU3/DSTU2, which won't work; note that
# a Read entry doesn't cover Search and vice versa — both are needed where
# both interactions are used below):
#   - Patient.Read / Patient.Search (Demographics)
#   - Condition.Read / Condition.Search (Problems, Reason for Visit)
#   - DocumentReference.Read / DocumentReference.Search (Clinical Notes)
#   - Binary.Read (Clinical Notes) — backs reading a note's actual content
#   - Whatever Incoming API backs Patient.$summary / International Patient
#     Summary — search the Incoming APIs list for "summary" or "IPS"
# Newly-added entries can take a while to actually take effect even after
# saving, despite showing as saved immediately in the Epic UI.
# The Endpoint URI on that same page must exactly match your current dev
# tunnel URL (e.g. ngrok), and gets out of date whenever that URL changes.
EXPO_PUBLIC_EPIC_CLIENT_ID=
# Optional overrides — defaults match the documented sandbox. If you set
# EXPO_PUBLIC_EPIC_SCOPES yourself, make sure it includes the Condition and
# DocumentReference (read + search)/Binary scopes too, not just Patient —
# otherwise leave it blank and the app's own default (covers all of the
# above) is used.
EXPO_PUBLIC_EPIC_SANDBOX_URL=
EXPO_PUBLIC_EPIC_SCOPES=
