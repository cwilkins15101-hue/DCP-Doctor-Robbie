# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Dragon Copilot — no sign-in needed, this is a plain server upload ---
# The deployed Azure Function's real URL (check the Portal's "Default
# domain" field — Flex Consumption apps get a randomized hostname suffix).
# e.g. https://dr-robbie-gwctbmh0cwc2bzbz.westus3-01.azurewebsites.net
EXPO_PUBLIC_DDE_SERVER_URL=
# Must match APP_SHARED_SECRET in the Function App's settings.
EXPO_PUBLIC_DDE_APP_SECRET=
# Required — identifies which physician this is to Dragon Copilot. Must
# exactly match an "App user ID" registered on the Clinical app connector in
# the Dragon Admin Center (admin.healthplatform.microsoft.com) — an
# unregistered value is rejected with "Forbidden". Defaults to
# "doctor-robbie-physician" if unset, which is NOT a registered ID; set this
# to your real registered App user ID (e.g. "craigwilkins").
EXPO_PUBLIC_DRAGON_EXTERNAL_USER_ID=
