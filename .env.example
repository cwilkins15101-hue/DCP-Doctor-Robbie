# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Existing pipeline (Claude / OpenAI) ---
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# --- Dragon Copilot (web only) ---
# From your Dragon Copilot partner sandbox:
EXPO_PUBLIC_DRAGON_PARTNER_GUID=
EXPO_PUBLIC_DRAGON_ENVIRONMENT_ID=
EXPO_PUBLIC_DRAGON_MEDICAL_SERVER_URL=
EXPO_PUBLIC_DRAGON_MEDICAL_SERVER_SCOPE=
EXPO_PUBLIC_DRAGON_CONFIG_SERVICE_URL=
EXPO_PUBLIC_DRAGON_CONFIG_SERVICE_SCOPE=
EXPO_PUBLIC_DRAGON_EHR_INTEGRATION_URL=
EXPO_PUBLIC_DRAGON_EHR_INTEGRATION_SCOPE=
EXPO_PUBLIC_DRAGON_SPEECH_LANGUAGE=en-US

# From your Microsoft Entra ID app registration:
EXPO_PUBLIC_ENTRA_CLIENT_ID=
EXPO_PUBLIC_ENTRA_AUTHORITY=https://login.microsoftonline.com/common
